{
  "name": "memberships",
  "displayName": "Gestión de socios",
  "version": "2.11.0",
  "repository": "DavidMRGaona/guildforge-memberships",
  "namespace": "Modules\\Memberships",
  "provider": "MembershipsServiceProvider",
  "description": "Módulo de gestión de socios, membresías y cuotas",
  "author": "GuildForge",
  "requires": {
    "core": "^3.47",
    "filament": "^5.0",
    "php": ">=8.5",
    "laravel": ">=13.0"
  },
  "storesUtc": true,
  "dependencies": [],
  "provides": {
    "permissions": [
      "members.view_any",
      "members.view",
      "members.create",
      "members.update",
      "members.delete",
      "fee_structures.view_any",
      "fee_structures.view",
      "fee_structures.create",
      "fee_structures.update",
      "fee_structures.delete",
      "fees.view_any",
      "fees.manage",
      "settings.manage"
    ],
    "routes": [
      "api",
      "web"
    ],
    "filament": true,
    "frontend": false,
    "inertia_share": false
  }
}
